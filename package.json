{
  "name": "turnapplota",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-database.ts",
    "db:import-protocols": "dotenv -e .env.local -- tsx scripts/import-protocols.ts",
    "db:normalize-protocols": "dotenv -e .env.local -- tsx scripts/normalize-protocols.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:check-protocols": "dotenv -e .env.local -- tsx scripts/check-protocols.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.8.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.0",
    "jspdf": "^3.0.0",
    "lucide-react": "^0.545.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
